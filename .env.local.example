# Copy this file to .env.local and fill in the values

# MongoDB connection string
# Local dev: mongodb://localhost:27017/okr-app
# Atlas:     mongodb+srv://<user>:<password>@cluster.mongodb.net/okr-app
MONGODB_URI=mongodb://localhost:27017/okr-app

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-secure-random-string

# Email — Resend (https://resend.com, free tier)
RESEND_API_KEY=re_...
EMAIL_FROM=OKRs <noreply@yourdomain.com>

# Public app URL (used in reset-password email links)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Invite-only registration — set this to require an invite code on /register
# Leave unset (or empty) to allow open registration
# REGISTRATION_CODE=your-secret-invite-code

# Phase 2: Anthropic API for AI features
# ANTHROPIC_API_KEY=sk-ant-...

# Node environment
NODE_ENV=development
